TARGET := overlay_anchor_test

# The unit under test is the shipping input/input_overlay_anchor.c
# (OpenEmux's anchor mode), built from the tree. input_driver.c calls
# it from input_overlay_poll; the test plays those calls poll by poll.
REPO_ROOT         := ../../..
LIBRETRO_COMM_DIR := $(REPO_ROOT)/libretro-common

SOURCES := overlay_anchor_test.c \
           $(REPO_ROOT)/input/input_overlay_anchor.c

OBJS := $(SOURCES:.c=.o)

CFLAGS += -DHAVE_OVERLAY -Wall -pedantic -std=c89 -Wno-long-long -g1 -O1 -fno-omit-frame-pointer \
          -I$(LIBRETRO_COMM_DIR)/include -I$(REPO_ROOT) -I$(REPO_ROOT)/deps

ifneq ($(SANITIZER),)
   CFLAGS  := -fsanitize=$(SANITIZER) $(CFLAGS)
   LDFLAGS := -fsanitize=$(SANITIZER) $(LDFLAGS)
endif

all: $(TARGET)

%.o: %.c
	$(CC) -c -o $@ $< $(CFLAGS)

$(TARGET): $(OBJS)
	$(CC) -o $@ $^ $(LDFLAGS)

check: $(TARGET)
	./$(TARGET)

clean:
	rm -f $(TARGET) $(OBJS)

.PHONY: all check clean
