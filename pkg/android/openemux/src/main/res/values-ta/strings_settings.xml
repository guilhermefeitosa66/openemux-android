    <!-- Artwork providers (issue 753). -->
    <string name="settings_section_artwork">கலைப்படம்</string>
    <string name="providers_title">கலைப்பட வழங்குநர்கள்</string>
    <string name="providers_desc">தேடல் வரிசை, மூலங்கள் மற்றும் ScreenScraper கணக்கு</string>
    <string name="providers_lead">கலைப்படத் தேடலும் தானியங்கி ஒத்திசைவும் இந்த வரிசையில் இந்த இடங்களில் தேடும். ஒத்திசைவு அட்டைகளுக்கு OpenEmux பிரதியையும் libretro வையும், லேபிள்களுக்கு ScreenScraper ஐயும் பயன்படுத்துகிறது.</string>
    <string name="providers_order">தேடல் வரிசை</string>
