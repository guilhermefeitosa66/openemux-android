    <string name="backup_exported">%1$s க்கு ஏற்றுமதி செய்யப்பட்டது · %2$s</string>
    <plurals name="backup_restored">
        <item quantity="one">%1$d விளையாட்டும் %2$d சேமிப்புகளும் நிலைகளும் மீட்டமைக்கப்பட்டன. OpenEmux இப்போது மறுதொடக்கம் ஆகும்.</item>
        <item quantity="other">%1$d விளையாட்டுகளும் %2$d சேமிப்புகளும் நிலைகளும் மீட்டமைக்கப்பட்டன. OpenEmux இப்போது மறுதொடக்கம் ஆகும்.</item>
    </plurals>
    <string name="backup_confirm_title">உங்கள் தரவை மாற்றவா?</string>
    <string name="backup_confirm_from">OpenEmux %1$s இலிருந்து, %2$s அன்று உருவாக்கப்பட்டது · %3$s</string>
    <string name="backup_confirm_note">இந்தப் போனில் உள்ள நூலகம், சேமிப்புகள் மற்றும் அமைப்புகள் மாற்றப்படும். முடிந்ததும் OpenEmux மறுதொடக்கம் ஆகும்.</string>
    <string name="backup_confirm">மாற்றி மீட்டமை</string>
    <string name="backup_err_invalid">இந்தக் கோப்பு OpenEmux காப்புப்பிரதி அல்ல, அல்லது சேதமடைந்துள்ளது. எதுவும் மாற்றப்படவில்லை.</string>
    <string name="backup_err_newer">இந்தக் காப்புப்பிரதி புதிய OpenEmux ஆல் உருவாக்கப்பட்டது. முதலில் ஆப்ஸைப் புதுப்பிக்கவும். எதுவும் மாற்றப்படவில்லை.</string>
    <string name="backup_err_space">போதுமான இடம் இல்லை: காப்புப்பிரதிக்கு %1$s தேவை, %2$s மட்டுமே காலியாக உள்ளது. எதுவும் மாற்றப்படவில்லை.</string>
    <string name="backup_err_write">காப்புப்பிரதியை எழுத முடியவில்லை. %1$s</string>
    <string name="backup_err_read">காப்புப்பிரதியைப் படிக்க முடியவில்லை. %1$s எதுவும் மாற்றப்படவில்லை.</string>
    <string name="backup_file_name">OpenEmux காப்புப்பிரதி %1$s</string>
