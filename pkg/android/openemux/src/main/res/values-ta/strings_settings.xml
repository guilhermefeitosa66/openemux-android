    <!-- Import -->
    <string name="settings_import_ext_title">.%1$s கோப்புகள்</string>
    <string name="settings_import_ext_question">பல கன்சோல்கள் இந்த நீட்டிப்பைப் பயன்படுத்துகின்றன. இந்த இறக்குமதியில் உள்ள .%1$s கோப்புகள் எந்தக் கன்சோலுக்கானவை?</string>
    <string name="settings_import_intro">உங்களிடம் உள்ள விளையாட்டுகளின் ROM-களைக் கொண்டு வாருங்கள். OpenEmux நீட்டிப்பைக் கொண்டு கன்சோலை அடையாளம் கண்டு, .zip கோப்புகளைத் தானாகவே திறக்கும்.</string>
