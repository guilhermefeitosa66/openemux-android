    <string name="settings_console_defaults_lead">தனி அமைப்பு இல்லாத இந்தக் கன்சோலின் எல்லா விளையாட்டுகளுக்கும் பொருந்தும்.</string>
    <string name="settings_theme_lead">உடனே மாறும், மறுதொடக்கம் தேவையில்லை. கார்ட்ரிட்ஜ்கள், அலமாரிகள், விளையாட்டுத் திரை, கட்டுப்படுத்தி ஸ்கின் ஆகியவை அப்படியே இருக்கும்.</string>
    <string name="settings_language_lead">செயலியின் உரைகளுக்குப் பொருந்தும். விளையாட்டுப் பெயர்கள் கோப்பைப் பின்பற்றும்.</string>
    <string name="settings_about_licenses">பற்றி மற்றும் உரிமங்கள்</string>
    <string name="settings_licenses_hint">முழு உரையைப் படிக்கத் தட்டவும்</string>
    <string name="settings_controller_layout">கன்ட்ரோலர் தளவமைப்பு</string>
    <string name="settings_controller_layout_lead">கன்ட்ரோலருக்கான ஃபோகஸையும் பொத்தான் குறிப்புகளையும் ஆப் எப்போது காட்டும்.</string>
    <string name="settings_controller_layout_auto">தானியங்கி</string>
    <string name="settings_controller_layout_auto_desc">கன்ட்ரோலர் இணைக்கப்பட்டிருக்கும்போது கன்ட்ரோலர் தளவமைப்பு.</string>
    <string name="settings_controller_layout_always">எப்போதும்</string>
    <string name="settings_controller_layout_always_desc">உள்ளமைந்த கட்டுப்பாடுகள் கொண்ட கையடக்கக் கருவிகளுக்கு.</string>
    <string name="settings_controller_layout_never">ஒருபோதும் இல்லை</string>
    <string name="settings_controller_layout_never_desc">கன்ட்ரோலர் இணைக்கப்பட்டிருந்தாலும் தொடுதிரை தளவமைப்பு.</string>
    <string name="settings_button_labels">பொத்தான் பெயர்கள்</string>
    <string name="settings_button_labels_lead">பொத்தான் குறிப்புகள் ஒவ்வொரு பொத்தானையும் எப்படிப் பெயரிடுகின்றன என்பது. கீழ்ப் பொத்தான் எப்போதும் உறுதிசெய்யும், வலது பொத்தான் பின்செல்லும்.</string>
    <string name="settings_button_labels_auto">தானியங்கி</string>
    <string name="settings_button_labels_auto_desc">பயன்பாட்டில் உள்ள கன்ட்ரோலரைப் பின்பற்றும். தெரியாதபோது Xbox பாணி.</string>
    <string name="settings_button_labels_xbox">Xbox</string>
