<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="oe_bg">#FF121216</color>
    <color name="oe_accent">#FF7C3AED</color>
    <color name="oe_icon_background">#FF14101C</color>
    <style name="Theme.OpenEmux.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/oe_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.OpenEmux" parent="Theme.OpenEmux.Base" />
    <!-- MainActivity's starting window: full screen, as the app is. The activity swaps it for Theme.OpenEmux before
         its window is made (FLAG_FULLSCREEN on the live window would turn adjustResize off below API 30). -->
    <style name="Theme.OpenEmux.Launch" parent="Theme.OpenEmux">
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- The skin editor over a paused game: translucent, so the game under it stays started. -->
    <style name="Theme.OpenEmux.GameSkin" parent="android:Theme.Translucent.NoTitleBar.Fullscreen" />
    <style name="Theme.OpenEmux.Game" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
