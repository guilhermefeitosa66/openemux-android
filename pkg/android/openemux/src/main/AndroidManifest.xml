<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- Android TV (issue 926): the app runs there with a controller, and on everything else without. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Share nearby: the Wi-Fi driver drops multicast (beacon, mDNS) without a
         MulticastLock. Normal permission, granted at install. Raising targetSdk
         past 36 may also need the local network runtime permission newer
         Android versions are adding. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Share nearby: a transfer runs in a dataSync foreground service with a
         progress notification, holding a partial wake lock and a Wi-Fi lock so
         it survives the screen going off. Android 15 caps dataSync at 6 h a
         day, far above any library transfer; whoever raises targetSdk past 36
         checks the foreground service type rules again. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.openemux.mobile.OpenEmuxApp"
        android:allowNativeHeapPointerTagging="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:appCategory="game"
        android:theme="@style/Theme.OpenEmux"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        tools:ignore="UnusedAttribute">

        <activity
            android:name="com.openemux.mobile.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenEmux.Launch"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The Android TV home screen (issue 926). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Share nearby: a QR code or link with another device's address
                 opens Connect by Address with it filled in, nothing more. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openemux-share" />
            </intent-filter>
        </activity>

        <!-- "Open with" and "Share" for ROM files (issue 792): imports them, never plays them.
             The library's own task comes up; this activity has no screen. -->
        <activity
