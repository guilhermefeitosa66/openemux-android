        <!-- The skin editor over a paused game (GameSkinActivity). density too: a fold or unfold that changes it must
             not recreate the activity, which would make the copy it edits a second time. -->
        <activity
            android:name="com.openemux.mobile.game.GameSkinActivity"
            android:process=":game"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.OpenEmux.GameSkin"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|fontScale" />
        <!-- The RetroArch engine in a process of its own: it exits the process
             when the content closes, and the library must survive that. Same
             task as the library, so the game opens inside the app. -->
        <activity
            android:name="com.openemux.mobile.game.GameActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.OpenEmux.Game"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="retroarch-activity" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
        </activity>
